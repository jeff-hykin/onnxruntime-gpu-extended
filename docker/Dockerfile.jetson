# syntax=docker/dockerfile:1
# Build an onnxruntime CUDA wheel for NVIDIA Jetson (aarch64 / L4T).
#
# This is the proven path for producing Jetson onnxruntime-gpu wheels on an x86_64
# host: build inside an aarch64 container on NVIDIA's L4T base image (CUDA + cuDNN
# + TensorRT already present at JetPack paths). Run it on a native aarch64 host for
# speed, or on x86_64 via qemu binfmt emulation (slow but works):
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#
# Args let one Dockerfile cover the whole matrix (see TARGETS.md):
#   L4T_TAG     base image tag        JP6 -> r36.4.0 (CUDA 12.6), JP5 -> r35.1.0 (CUDA 11.4)
#   ORT_VERSION onnxruntime git tag   JP6 -> v1.22.2 ; JP5 -> v1.18.1, the last
#                                     release whose cmake accepts CUDA 11.4
#   PYTHON_VERSION  e.g. 3.12
#   CUDA_ARCH   SM without dot         Orin 87, Xavier 72
#
# onnxruntime version choice: v1.22.2 pins abseil 20240722.0, which nvcc's C++
# frontend compiles cleanly. Newer onnxruntime (>=1.23) pins abseil lts_2025xx,
# which nvcc used to choke on; docker/patch_abseil.py now fixes that at the
# source, so newer ORT_VERSIONs are buildable (see the abseil stage below).
ARG L4T_TAG=r36.4.0
FROM nvcr.io/nvidia/l4t-jetpack:${L4T_TAG} AS build

ARG ORT_VERSION=v1.22.2
ARG PYTHON_VERSION=3.12
ARG CUDA_ARCH=87
# Compile parallelism. Keep modest under qemu emulation: each emulated nvcc/cicc
# can use 1-2GB, so high -j risks OOM. Raise on a native aarch64 host.
ARG BUILD_JOBS=8
# gcc-12 pairs with CUDA 12.6 on the JP6 base. CUDA 11.4 (JP5) does not accept it
# and Ubuntu 20.04 does not package it, so pass "none" there to keep the base
# image's own compiler. ("" means the same, but `gh workflow run -f x=` drops the
# field entirely and the input default comes back.)
ARG GCC_VERSION=12
# deadsnakes stopped publishing for Ubuntu 20.04, which is what the JP5 base is
# built on. `uv` supplies portable CPython builds for every version instead.
ARG PYTHON_SOURCE=deadsnakes
# onnxruntime 1.18 calls cmake_policy(SET CMP0104 OLD), and cmake 4 deleted that
# policy, so a CUDA 11 build has to stay on cmake 3.
ARG CMAKE_SPEC=cmake>=3.28

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates gnupg git wget curl \
        build-essential ninja-build; \
    if [ -n "${GCC_VERSION}" ] && [ "${GCC_VERSION}" != none ]; then \
        apt-get install -y --no-install-recommends \
            gcc-${GCC_VERSION} g++-${GCC_VERSION}; \
        update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCC_VERSION} 100; \
        update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-${GCC_VERSION} 100; \
    fi; \
    if [ "${PYTHON_SOURCE}" = deadsnakes ]; then \
        add-apt-repository -y ppa:deadsnakes/ppa; \
        apt-get update; \
        apt-get install -y --no-install-recommends \
            python${PYTHON_VERSION} python${PYTHON_VERSION}-dev \
            python${PYTHON_VERSION}-venv; \
    else \
        curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh; \
        uv python install ${PYTHON_VERSION}; \
        ln -s "$(uv python find ${PYTHON_VERSION})" /usr/local/bin/python${PYTHON_VERSION}; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    rm -rf /usr/include/python*/numpy

# Isolated venv for the target python; recent cmake/build deps via pip (Ubuntu
# 22.04 apt cmake is too old for onnxruntime 1.26).
RUN python${PYTHON_VERSION} -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -U pip wheel setuptools && \
    /opt/venv/bin/pip install --no-cache-dir "${CMAKE_SPEC}" numpy packaging
ENV PATH=/opt/venv/bin:$PATH

# onnxruntime source (FetchContent deps resolve over the network at build time —
# fine in Docker, unlike the Nix sandbox).
RUN git clone --recursive --depth 1 --branch ${ORT_VERSION} \
        https://github.com/microsoft/onnxruntime /opt/onnxruntime

# Pre-fetch cutlass (largest FetchContent dep): its zip download over HTTP/2 from
# github intermittently fails ("Stream error in the HTTP/2 framing layer"). Clone
# it via git and point FetchContent at the local copy (FETCHCONTENT_SOURCE_DIR_*),
# the same approach nixpkgs uses. The tag is read out of onnxruntime's own
# cmake/deps.txt so it tracks ORT_VERSION instead of drifting (1.22.2 wants
# v3.5.1, 1.23.2 wants v3.9.2). CUTLASS_TAG overrides it if ever needed.
ARG CUTLASS_TAG=
RUN set -eux; \
    tag=${CUTLASS_TAG:-$(sed -n 's#^cutlass;.*/tags/\(.*\)\.zip;.*#\1#p' \
            /opt/onnxruntime/cmake/deps.txt)}; \
    test -n "$tag"; \
    git clone --depth 1 --branch "$tag" \
        https://github.com/NVIDIA/cutlass /opt/cutlass

# Pre-fetch eigen for a different reason: onnxruntime <=1.20 fetches it from
# gitlab, whose generated zip archives are not byte-stable, so the URL_HASH
# recorded in deps.txt no longer matches what gitlab serves and cmake rejects the
# download. onnxruntime hit the same wall and switched to the github mirror in
# 1.22; take the commit out of deps.txt and get it from there.
RUN set -eux; \
    sha=$(sed -n 's#^eigen;.*/\([0-9a-f]\{40\}\)/.*#\1#p' /opt/onnxruntime/cmake/deps.txt); \
    test -n "$sha"; \
    wget -q -O /tmp/eigen.zip "https://github.com/eigen-mirror/eigen/archive/${sha}.zip"; \
    python -c "import zipfile; zipfile.ZipFile('/tmp/eigen.zip').extractall('/opt')"; \
    mv /opt/eigen-${sha} /opt/eigen; \
    rm /tmp/eigen.zip

COPY docker/patch_abseil.py /opt/patch_abseil.py

WORKDIR /opt/onnxruntime
# CUDA + cuDNN ship in the L4T base at standard paths. Build the python wheel for
# the requested SM only (keeps emulated builds tractable).
#
# Python_NumPy_INCLUDE_DIR is pinned to the venv's numpy on purpose. The L4T base
# is Ubuntu 22.04, whose apt python3-numpy is 1.x and installs its headers into
# /usr/include/python3.10/numpy — i.e. inside Python_INCLUDE_DIRS, so at
# PYTHON_VERSION=3.10 `#include <numpy/arrayobject.h>` resolved to numpy 1 no
# matter what this pin said, and the wheel then imported only under numpy<2
# ("_ARRAY_API not found"). Deleting that directory above is what actually fixes
# it; 3.11+ come from deadsnakes and never had the shadowing dir.
#
# Configure and compile are split so abseil can be patched in between. abseil
# lts_2025xx (onnxruntime >=1.23) writes `IfRRef<X>::AddPtr<Y>`; nvcc re-emits
# that for the host compiler with a `typename` prefix and no `template` keyword,
# which is ill-formed, so gcc rejects it — reproduced on gcc 11 through 16, so a
# host-compiler swap does not help. Patching after --update (rather than
# overriding FETCHCONTENT_SOURCE_DIR_ABSEIL_CPP) keeps onnxruntime's own abseil
# patches, which a source-dir override would silently skip. No-ops on the older
# abseil that 1.22.x pins.
RUN NUMPY_INCLUDE=$(python -c "import numpy; print(numpy.get_include())") && \
    ./build.sh \
        --config Release \
        --update --parallel ${BUILD_JOBS} \
        --compile_no_warning_as_error \
        --use_cuda \
        --cuda_home /usr/local/cuda \
        --cudnn_home /usr \
        --build_wheel \
        --skip_tests \
        --allow_running_as_root \
        --cmake_extra_defines \
            CMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
            onnxruntime_BUILD_UNIT_TESTS=OFF \
            FETCHCONTENT_SOURCE_DIR_CUTLASS=/opt/cutlass \
            FETCHCONTENT_SOURCE_DIR_EIGEN=/opt/eigen \
            Python_NumPy_INCLUDE_DIR=${NUMPY_INCLUDE}

RUN python /opt/patch_abseil.py build/Linux/Release/_deps/abseil_cpp-src

RUN ./build.sh \
        --config Release \
        --build --parallel ${BUILD_JOBS} \
        --compile_no_warning_as_error \
        --use_cuda \
        --cuda_home /usr/local/cuda \
        --cudnn_home /usr \
        --build_wheel \
        --skip_tests \
        --allow_running_as_root

# Collect the wheel at a predictable path.
RUN mkdir -p /wheels && cp build/Linux/Release/dist/*.whl /wheels/

# Export-only stage: lets `docker buildx build --target wheel \
#   --output type=local,dest=./wheels` drop just the .whl on the host.
FROM scratch AS wheel
COPY --from=build /wheels/ /

# Smoke-test the wheel in a clean venv, against whatever numpy pip resolves for
# this Python. Catches ABI breakage here rather than after a 4-hour CI run.
# `import onnxruntime` needs no GPU — the CUDA provider is only dlopened when a
# session is created.
#
# Kept in its own stage so the wheel can be exported (--target wheel) before the
# test runs; a failing test then costs a re-test, not a 4-hour recompile.
# Runs from /tmp because the build tree's own onnxruntime/ source dir shadows the
# installed package.
FROM build AS smoketest
ARG PYTHON_VERSION
RUN cd /tmp && python${PYTHON_VERSION} -m venv /opt/smoketest && \
    /opt/smoketest/bin/pip install --no-cache-dir -q /wheels/*.whl && \
    /opt/smoketest/bin/python -c "\
import numpy, onnxruntime; \
print('smoke test: numpy', numpy.__version__, '/ onnxruntime', onnxruntime.__version__); \
print('providers:', onnxruntime.get_available_providers()); \
assert 'CUDAExecutionProvider' in onnxruntime.get_available_providers()"
